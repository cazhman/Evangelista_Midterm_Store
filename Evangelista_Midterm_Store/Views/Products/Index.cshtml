@model IEnumerable<Evangelista_Midterm_Store.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Product Store</h2>
    <a asp-action="Create" class="btn btn-primary">+ Add New Product</a>
</div>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <span class="badge bg-secondary mb-2">@item.Category</span>
                    <h5 class="card-title">@item.Name</h5>
                    <p class="card-text text-muted">@item.Description</p>
                    <h6 class="text-success fw-bold">₱@item.Price.ToString("N2")</h6>
                </div>
                <div class="card-footer bg-white d-flex justify-content-between align-items-center">
                    <form asp-action="AddToCart" method="post" class="d-inline">
                        <input type="hidden" name="productId" value="@item.Id" />
                        <button type="submit" class="btn btn-sm btn-success">Add to Cart</button>
                    </form>
                    <div>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Edit</a>
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Delete product?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>